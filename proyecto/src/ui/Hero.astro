---
import type { PublishedContent } from "../content";
import type { UiStrings } from "../i18n/ui";
import PixelIcon from "./PixelIcon.astro";

interface Props {
  profile: PublishedContent["profile"];
  t: UiStrings;
  mailto: string;
  cvHref: string;
}

const { profile, t, mailto, cvHref } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="window hero-window">
      <div class="window-bar">
        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="bar-title">{t.windowTitle}</span>
      </div>

      <div class="hero-body">
        <div class="hero-text">
          <p class="prompt" aria-hidden="true"><span>$</span> whoami</p>
          <p class="badge">{profile.title}</p>
          <h1 id="hero-title">
            <span class="hello">{t.hello}</span>
            <span class="name">{profile.name}</span>
          </h1>
          <p class="slogan">
            <span class="typed">{profile.slogan}</span><span class="cursor" aria-hidden="true"></span>
          </p>
          {profile.headline && <p class="headline">{profile.headline}</p>}
          <div class="actions">
            <a class="btn btn-primary" href="#projects">{t.viewProjects}</a>
            <a class="btn btn-secondary" href={mailto}>{t.startMission}</a>
            <a class="btn btn-secondary" href={cvHref} download>
              <PixelIcon name="download" />
              {t.downloadCv}
            </a>
          </div>
        </div>

        <div class="hero-art" aria-hidden="true">
          <span class="diamond d1"></span>
          <span class="diamond d2"></span>
          <span class="diamond d3"></span>
          <img class="logo" src="/brand/shardev-logo.svg" alt="" width="220" height="220" />
          <div class="status">
            <div class="lottie" data-lottie="/lottie/loading.json"></div>
            <p class="status-text">{t.status}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    min-height: calc(100svh - 4.25rem);
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }
  .prompt {
    margin-bottom: 1rem;
    font: 600 1.5rem / 1 var(--font-display);
    letter-spacing: 0.04em;
    color: var(--c-ink-soft);
  }
  .prompt span {
    color: var(--c-ink);
  }
  :global([data-theme="dark"]) .prompt span {
    color: var(--c-primary);
  }
  .bar-title {
    font-size: 1.125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-body {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.75rem, 5vw, 4rem);
  }
  .badge {
    display: inline-block;
    padding: 0.35rem 0.75rem 0.25rem;
    background: var(--c-primary);
    color: var(--c-on-primary);
    border: var(--border);
    font: 600 1.25rem/1 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h1 {
    margin-top: 1.25rem;
  }
  .hello {
    display: block;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--c-ink-soft);
  }
  .name {
    display: block;
    font-size: clamp(3.5rem, 10vw, 7rem);
    line-height: 0.95;
  }
  .slogan {
    margin-top: 1rem;
    font: 600 clamp(1.5rem, 3.5vw, 2.25rem) / 1.1 var(--font-display);
  }
  .typed {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: type 1.6s steps(24, end) 0.4s forwards;
  }
  @keyframes type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .headline {
    margin-top: 1rem;
    max-width: 48ch;
    font-size: 1.125rem;
    color: var(--c-ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
  .hero-art {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }
  .logo {
    width: min(100%, 15rem);
    height: auto;
    filter: drop-shadow(8px 8px 0 var(--c-shadow));
    animation: float 3.2s ease-in-out infinite alternate;
  }
  @keyframes float {
    to {
      transform: translateY(-10px);
    }
  }
  .status {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    width: 100%;
  }
  .lottie {
    width: min(100%, 17rem);
    aspect-ratio: 272 / 46;
  }
  .status-text {
    font: 600 1.25rem/1 var(--font-display);
    letter-spacing: 0.08em;
    color: var(--c-ink-soft);
  }
  .diamond {
    position: absolute;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--c-primary);
    transform: rotate(45deg);
    animation: blink 2.4s steps(1, end) infinite;
  }
  .d1 {
    top: 4%;
    left: 6%;
  }
  .d2 {
    top: 18%;
    right: 4%;
    width: 0.55rem;
    height: 0.55rem;
    background: var(--c-accent);
    animation-delay: 0.8s;
  }
  .d3 {
    bottom: 30%;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    animation-delay: 1.6s;
  }

  @media (max-width: 760px) {
    .hero-body {
      grid-template-columns: 1fr;
    }
    .hero-art {
      order: -1;
    }
    .logo {
      width: 9rem;
    }
    .actions .btn {
      flex: 1 1 12rem;
    }
  }
</style>

<script>
  // Plays the hand-made Lottie (JSON) loading bar; static when motion is reduced.
  const el = document.querySelector<HTMLElement>("[data-lottie]");
  if (el?.dataset.lottie) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    import("lottie-web/build/player/lottie_light").then(({ default: lottie }) => {
      const anim = lottie.loadAnimation({
        container: el,
        renderer: "svg",
        loop: !reduced,
        autoplay: !reduced,
        path: el.dataset.lottie,
      });
      if (reduced) anim.addEventListener("DOMLoaded", () => anim.goToAndStop(100, true));
    });
  }
</script>
