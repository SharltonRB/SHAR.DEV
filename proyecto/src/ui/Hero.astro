---
import type { PublishedContent } from "../content";
import type { UiStrings } from "../i18n/ui";
import PixelIcon from "./PixelIcon.astro";

interface Props {
  profile: PublishedContent["profile"];
  t: UiStrings;
  mailto: string;
  cvHref: string;
  linkedinUrl: string | null;
}

const { profile, t, mailto, cvHref, linkedinUrl } = Astro.props;

// The name rises letter by letter: first word in light ink, the rest orange.
const [first, ...rest] = profile.name.split(" ");
const words = [
  { text: first, tone: "light" },
  ...(rest.length ? [{ text: rest.join(" "), tone: "orange" }] : []),
];
let letterIndex = 0;
const nameWords = words.map((w) => ({
  tone: w.tone,
  letters: [...w.text].map((ch) => ({ ch, i: letterIndex++ })),
}));

// Seed lines of the live request log (the script keeps adding more).
const seedLog = [
  { method: "GET", path: "/projects", status: 200, ms: 18 },
  { method: "GET", path: "/experience", status: 200, ms: 12 },
  { method: "POST", path: "/missions", status: 201, ms: 41 },
  { method: "GET", path: "/skills", status: 200, ms: 9 },
];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container">
    <div class="window hero-window">
      <div class="window-bar">
        <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="bar-title">{t.windowTitle}</span>
      </div>

      <div class="hero-body">
        <div class="hero-text">
          <ol class="boot" aria-hidden="true">
            {
              t.boot.map((line, i) => (
                <li style={`--d: ${150 + i * 300}ms`}>
                  <span class="caret">&gt;</span>
                  <span class="line">{line}</span>
                  {i === t.boot.length - 1 && <span class="ok">✓</span>}
                </li>
              ))
            }
          </ol>

          <p class="badge">{profile.title}</p>
          <h1 id="hero-title">
            <span class="hello">{t.hello}</span>
            <span class="visually-hidden">{profile.name}</span>
            <span class="name" aria-hidden="true">
              {
                nameWords.map((w) => (
                  <span class:list={["word", `tone-${w.tone}`]}>
                    {w.letters.map((l) => (
                      <span class="letter" style={`--i: ${l.i}`}>
                        {l.ch}
                      </span>
                    ))}
                  </span>
                ))
              }
            </span>
          </h1>
          <p class="slogan">
            <span class="typed">{profile.slogan}</span><span class="cursor" aria-hidden="true"></span>
          </p>
          {profile.headline && <p class="headline">{profile.headline}</p>}
          <div class="actions">
            <a class="btn btn-primary" href="#projects">{t.viewProjects}</a>
            <a class="btn btn-secondary" href={mailto}>{t.startMission}</a>
            <a class="btn btn-secondary" href={cvHref} download>
              <PixelIcon name="download" />
              {t.downloadCv}
            </a>
          </div>
        </div>

        <div class="hero-art" data-parallax>
          <span class="diamond d1" aria-hidden="true"></span>
          <span class="diamond d2" aria-hidden="true"></span>
          <span class="diamond d3" aria-hidden="true"></span>
          <div class="logo-wrap">
            {
              linkedinUrl ? (
                <a class="photo" href={linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label={t.photoLink}>
                  <span class="photo-bar" aria-hidden="true">
                    <span>sharlton.jpg</span>
                    <PixelIcon name="linkedin" />
                  </span>
                  <span class="photo-frame">
                    <img class="portrait" src="/brand/sharlton.jpg" alt={t.photoAlt} width="588" height="640" />
                    <span class="photo-overlay" aria-hidden="true">
                      <PixelIcon name="linkedin" class="overlay-icon" />
                      <span>{t.contact.linkedin}</span>
                    </span>
                  </span>
                </a>
              ) : (
                <div class="photo">
                  <span class="photo-bar" aria-hidden="true">
                    <span>sharlton.jpg</span>
                  </span>
                  <span class="photo-frame">
                    <img class="portrait" src="/brand/sharlton.jpg" alt={t.photoAlt} width="588" height="640" />
                  </span>
                </div>
              )
            }
            <img class="logo badge-logo" src="/brand/shardev-logo.svg" alt="" width="220" height="220" aria-hidden="true" />
          </div>
          <div class="status" aria-hidden="true">
            <div class="lottie" data-lottie="/lottie/loading.json"></div>
            <p class="status-text">{t.status}</p>
          </div>
          <div class="log" aria-hidden="true">
            <p class="log-head"><span class="live-dot"></span>{t.liveLog}</p>
            <ul data-log>
              {
                seedLog.map((r) => (
                  <li>
                    <span class={`method m-${r.method.toLowerCase()}`}>{r.method}</span>
                    <span class="path">{r.path}</span>
                    <span class="code">{r.status}</span>
                    <span class="ms">{r.ms}ms</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    min-height: calc(100svh - 4.25rem);
    padding-block: clamp(1.5rem, 4vw, 3rem);
  }

  /* Light window in light mode, dark terminal in dark mode. It fills the
     first screen. */
  .hero-window {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 4.25rem - 2 * clamp(1.5rem, 4vw, 3rem));
    background-color: var(--c-surface);
    background-image:
      linear-gradient(var(--c-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-grid) 1px, transparent 1px);
    background-size: 28px 28px;
    box-shadow: 10px 10px 0 var(--c-shadow);
    animation: window-in 600ms var(--ease-out) both;
  }
  :global([data-theme="dark"]) .hero-window {
    border-color: var(--c-primary);
    background-color: #0a0a0a;
    background-image:
      linear-gradient(rgb(255 107 53 / 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 107 53 / 0.09) 1px, transparent 1px);
  }
  @keyframes window-in {
    from {
      opacity: 0;
      transform: translate3d(0, 18px, 0) scale(0.985);
    }
  }
  .bar-title {
    font-size: 1.125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero-body {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(1.5rem, min(5vw, 5svh), 5rem) clamp(1.75rem, 5vw, 5rem);
  }

  /* Boot sequence */
  .boot {
    list-style: none;
    margin: 0 0 clamp(0.75rem, 2svh, 1.5rem);
    padding: 0;
    display: grid;
    gap: 0.25rem;
    font: 600 clamp(1.25rem, 1.3vw, 1.875rem) / 1.2 var(--font-display);
    letter-spacing: 0.04em;
    color: var(--c-ink-soft);
  }
  .boot li {
    display: flex;
    gap: 0.5rem;
    opacity: 0;
    animation: fade 1ms linear var(--d) forwards;
  }
  .boot .caret {
    color: var(--c-ink);
  }
  :global([data-theme="dark"]) .boot .caret,
  :global([data-theme="dark"]) .boot .ok {
    color: var(--c-primary);
  }
  .boot .line {
    clip-path: inset(0 100% 0 0);
    animation: type 380ms steps(28, end) var(--d) forwards;
  }
  .boot .ok {
    color: var(--c-ink);
    opacity: 0;
    animation: fade 1ms linear calc(var(--d) + 420ms) forwards;
  }
  @keyframes fade {
    to {
      opacity: 1;
    }
  }
  @keyframes type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .badge {
    display: inline-block;
    padding: 0.35rem 0.75rem 0.25rem;
    background: var(--c-primary);
    color: var(--c-on-primary);
    font: 600 1.25rem / 1 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    animation: rise 500ms var(--ease-out) 1050ms both;
  }
  h1 {
    margin-top: 1.25rem;
  }
  .hello {
    display: block;
    font-size: clamp(1.75rem, 2.6vw, 3.75rem);
    color: var(--c-ink-soft);
    animation: rise 500ms var(--ease-out) 1150ms both;
  }
  .name {
    display: block;
    font-size: clamp(3.5rem, min(8.5vw, 13svh), 13rem);
    line-height: 0.92;
  }
  .word {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.22em;
  }
  .tone-light {
    color: var(--c-ink);
  }
  :global([data-theme="dark"]) .tone-light {
    color: #fafafa;
  }
  /* Orange text only on dark: in light mode the word sits on an orange block. */
  .tone-orange {
    margin-top: 0.08em;
    padding: 0.04em 0.12em 0;
    color: var(--c-on-primary);
    background: var(--c-primary);
    box-shadow: 6px 6px 0 var(--c-ink);
  }
  :global([data-theme="dark"]) .tone-orange {
    padding: 0;
    color: var(--c-primary);
    background: none;
    box-shadow: none;
  }
  .letter {
    display: inline-block;
    animation: letter 560ms var(--ease-out) calc(1250ms + var(--i) * 35ms) both;
  }
  @keyframes letter {
    from {
      opacity: 0;
      transform: translate3d(0, 0.45em, 0);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
  }
  .slogan {
    margin-top: 1rem;
    font: 600 clamp(1.5rem, 2.4vw, 3.5rem) / 1.1 var(--font-display);
    color: var(--c-ink);
  }
  .typed {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    animation: type 1.1s steps(24, end) 1.85s forwards;
  }
  .headline {
    margin-top: 1rem;
    max-width: 48ch;
    font-size: 1.125rem;
    color: var(--c-ink-soft);
  }
  .actions .btn {
    font-size: clamp(1.375rem, 1.15vw, 1.75rem);
    min-height: clamp(2.875rem, 2.6vw, 3.5rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
    animation: rise 600ms var(--ease-out) 2.1s both;
  }

  /* Art column: logo with pointer parallax, Lottie bar and live log */
  .hero-art {
    --px: 0;
    --py: 0;
    position: relative;
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    animation: rise 700ms var(--ease-out) 500ms both;
  }
  .logo-wrap {
    transform: translate3d(calc(var(--px) * 14px), calc(var(--py) * 14px), 0);
    transition: transform 400ms var(--ease-out);
  }
  .logo-wrap {
    position: relative;
    width: fit-content;
    max-width: 100%;
  }
  .photo {
    display: block;
    width: clamp(14rem, 17vw, 24rem);
    max-width: 100%;
    color: inherit;
    text-decoration: none;
    background: var(--c-surface);
    border: var(--border);
    box-shadow: calc(8px - var(--px) * 6px) calc(8px - var(--py) * 6px) 0 var(--c-shadow);
  }
  :global([data-theme="dark"]) .photo {
    border-color: var(--c-primary);
  }
  .photo-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.35rem 0.65rem;
    background: var(--c-primary);
    color: var(--c-on-primary);
    border-bottom: var(--border);
    font: 600 1.125rem / 1 var(--font-display);
    letter-spacing: 0.04em;
  }
  .photo-frame {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 588 / 640;
  }
  .portrait {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      filter 320ms var(--ease-out),
      transform 420ms var(--ease-out);
  }
  .photo-overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    color: #fafafa;
    font: 600 1.75rem / 1 var(--font-display);
    letter-spacing: 0.06em;
    opacity: 0;
    transition: opacity 260ms var(--ease-out);
  }
  .photo-overlay :global(.overlay-icon) {
    width: 4rem;
    height: 4rem;
    padding: 0.6rem;
    color: var(--c-on-primary);
    background: var(--c-primary);
    box-shadow: 5px 5px 0 #0a0a0a;
  }
  a.photo:hover .portrait,
  a.photo:focus-visible .portrait {
    filter: blur(4px) brightness(0.5);
    transform: scale(1.05);
  }
  a.photo:hover .photo-overlay,
  a.photo:focus-visible .photo-overlay {
    opacity: 1;
  }
  .badge-logo {
    position: absolute;
    right: -1.75rem;
    bottom: -1.75rem;
  }
  .logo {
    width: clamp(4.5rem, 5.5vw, 7rem);
    height: auto;
    filter: drop-shadow(calc(8px - var(--px) * 6px) calc(8px - var(--py) * 6px) 0 var(--c-shadow));
    animation: float 3.2s ease-in-out infinite alternate;
  }
  @keyframes float {
    to {
      transform: translateY(-10px);
    }
  }
  .status {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    width: 100%;
  }
  .lottie {
    width: min(100%, clamp(16rem, 19vw, 30rem));
    aspect-ratio: 272 / 46;
  }
  .status-text {
    font: 600 1.25rem / 1 var(--font-display);
    letter-spacing: 0.08em;
    color: var(--c-ink-soft);
  }

  /* The log is a small dark screen in both themes. */
  .log {
    --c-ink: #d4d4d8;
    --c-ink-soft: #a1a1aa;
    --c-accent: #ff9a5c;
    width: min(100%, clamp(21rem, 25vw, 36rem));
    border: 3px solid var(--c-shadow);
    background: #0a0a0a;
    font-size: clamp(0.8125rem, 0.85vw, 1.125rem);
  }
  .log-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-bottom: 2px solid #3f3f46;
    font: 600 1rem / 1 var(--font-display);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--c-primary);
    animation: blink 1.2s steps(1, end) infinite;
  }
  .log ul {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.75rem;
    height: 7.25rem;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, #000 65%, transparent);
    display: grid;
    align-content: start;
    gap: 0.3rem;
    font-variant-numeric: tabular-nums;
  }
  .log li {
    display: grid;
    grid-template-columns: 2.6rem 1fr auto 3rem;
    gap: 0.5rem;
    white-space: nowrap;
  }
  .log :global(li.is-new) {
    animation: log-in 420ms var(--ease-out);
  }
  @keyframes log-in {
    from {
      opacity: 0;
      transform: translate3d(0, -100%, 0);
    }
  }
  .method {
    font-weight: 700;
    color: #fafafa;
  }
  .m-post {
    color: var(--c-accent);
  }
  .path {
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--c-ink);
  }
  .code {
    color: var(--c-primary);
    font-weight: 700;
  }
  .ms {
    text-align: right;
    color: var(--c-ink-soft);
  }

  .diamond {
    position: absolute;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--c-primary);
    transform: rotate(45deg);
    animation: blink 2.4s steps(1, end) infinite;
  }
  .d1 {
    top: 2%;
    left: 6%;
  }
  .d2 {
    top: 16%;
    right: 4%;
    width: 0.55rem;
    height: 0.55rem;
    background: var(--c-accent);
    animation-delay: 0.8s;
  }
  .d3 {
    bottom: 34%;
    left: 0;
    width: 0.55rem;
    height: 0.55rem;
    animation-delay: 1.6s;
  }

  @media (max-width: 860px) {
    .hero-body {
      grid-template-columns: 1fr;
    }
    .photo {
      width: 15rem;
    }
    .badge-logo {
      right: -1rem;
      bottom: -1rem;
    }
    .actions .btn {
      flex: 1 1 12rem;
    }
  }
  @media (max-width: 420px) {
    .boot {
      font-size: 1.0625rem;
    }
  }

  /* Reduced motion: everything is shown at once, nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .boot li,
    .boot .ok {
      opacity: 1;
    }
    .boot .line,
    .typed {
      clip-path: none;
    }
    .logo-wrap {
      transform: none;
    }
  }
</style>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Plays the hand-made Lottie (JSON) loading bar; static when motion is reduced.
  const el = document.querySelector<HTMLElement>("[data-lottie]");
  if (el?.dataset.lottie) {
    import("lottie-web/build/player/lottie_light").then(({ default: lottie }) => {
      const anim = lottie.loadAnimation({
        container: el,
        renderer: "svg",
        loop: !reduced,
        autoplay: !reduced,
        path: el.dataset.lottie,
      });
      if (reduced) anim.addEventListener("DOMLoaded", () => anim.goToAndStop(100, true));
    });
  }

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const art = document.querySelector<HTMLElement>("[data-parallax]");

  // Logo follows the pointer a little (mouse and trackpad only).
  if (hero && art && !reduced && matchMedia("(pointer: fine)").matches) {
    let frame = 0;
    hero.addEventListener("pointermove", (e) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const r = hero.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * 2 - 1;
        const y = ((e.clientY - r.top) / r.height) * 2 - 1;
        art.style.setProperty("--px", x.toFixed(3));
        art.style.setProperty("--py", y.toFixed(3));
      });
    });
    hero.addEventListener("pointerleave", () => {
      art.style.setProperty("--px", "0");
      art.style.setProperty("--py", "0");
    });
  }

  // Live request log: a new request every ~1.5 s while the hero is visible.
  const log = document.querySelector<HTMLUListElement>("[data-log]");
  if (log && hero && !reduced) {
    const routes: [string, string, number][] = [
      ["GET", "/projects", 200],
      ["GET", "/experience", 200],
      ["POST", "/missions", 201],
      ["GET", "/skills", 200],
      ["GET", "/cv.pdf", 200],
      ["GET", "/about", 200],
      ["POST", "/contact", 202],
      ["GET", "/health", 200],
    ];
    let n = 0;
    let timer = 0;
    const push = () => {
      const [method, path, status] = routes[n++ % routes.length];
      const li = document.createElement("li");
      li.className = "is-new";
      const cell = (cls: string, text: string) => {
        const span = document.createElement("span");
        span.className = cls;
        span.textContent = text;
        return span;
      };
      li.append(
        cell(`method m-${method.toLowerCase()}`, method),
        cell("path", path),
        cell("code", String(status)),
        cell("ms", `${3 + Math.floor(Math.random() * 45)}ms`),
      );
      // Astro scopes styles with a data attribute; copy it to the new nodes.
      const scope = [...(log.firstElementChild?.attributes ?? [])].find((a) =>
        a.name.startsWith("data-astro-cid"),
      );
      if (scope) {
        li.setAttribute(scope.name, "");
        for (const span of li.children) span.setAttribute(scope.name, "");
      }
      log.prepend(li);
      while (log.children.length > 6) log.lastElementChild?.remove();
    };
    new IntersectionObserver(([entry]) => {
      clearInterval(timer);
      if (entry.isIntersecting) timer = window.setInterval(push, 1500);
    }).observe(hero);
  }
</script>
