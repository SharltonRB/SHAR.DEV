  ],
  code: [
    "...#....#...",
    "..##....##..",
    ".##......##.",
    "##........##",
    ".##......##.",
    "..##....##..",
    "...#....#...",
  ],
  pin: [
    "...######...",
    "..##....##..",
    ".##..##..##.",
    ".##..##..##.",
    "..##....##..",
    "...##..##...",
    "....####....",
    ".....##.....",
  ],
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
const rows = icons[name];
const width = rows[0].length;
const height = rows.length;

const runs: { x: number; y: number; w: number }[] = [];
rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    if (row[x] === "#") {
      const start = x;
      while (row[x] === "#") x++;
      runs.push({ x: start, y, w: x - start });
    } else {
      x++;
    }
  }
});
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${height}`}
  width="1em"
  height="1em"
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {runs.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}
</svg>
