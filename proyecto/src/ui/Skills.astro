---
import type { PublishedContent } from "../content";
import type { UiStrings } from "../i18n/ui";
import TechIcon from "./TechIcon.astro";

interface Props {
  skillCategories: PublishedContent["skillCategories"];
  t: UiStrings;
}

const { skillCategories, t } = Astro.props;

/**
 * Bento sizes come from the content, so new categories still fit: the first
 * category (the core stack) is a tall accent tile, the largest one is a big
 * dark tile and the rest grow with how many skills they hold.
 */
const largest = Math.max(...skillCategories.map((c) => c.skills.length));
const tiles = skillCategories.map((category, i) => {
  const count = category.skills.length;
  let size = "sm";
  let tone = "light";
  if (i === 0) {
    size = "tall";
    tone = "accent";
  } else if (count === largest && count >= 8) {
    size = "big";
    tone = "dark";
  } else if (count >= 6) {
    size = "wide";
  }
  return { category, size, tone };
});
---

{
  skillCategories.length > 0 && (
    <section id="skills" class="section skills" aria-labelledby="skills-title">
      <div class="container">
        <div class="section-head reveal">
          <h2 id="skills-title" class="section-title">{t.skills.title}</h2>
          <p class="section-intro">{t.skills.intro}</p>
        </div>

        <div class="bento">
          {tiles.map(({ category, size, tone }, i) => (
            <section
              class:list={["tile", `size-${size}`, `tone-${tone}`, "reveal"]}
              style={`--delay: ${(i % 4) * 80}ms`}
              aria-labelledby={`skill-cat-${i}`}
            >
              <div class="tile-head">
                <span class="tile-mark" aria-hidden="true" />
                <h3 id={`skill-cat-${i}`}>{category.name}</h3>
              </div>
              <ul>
                {category.skills.map((skill) => (
                  <li>
                    <TechIcon name={skill.name} />
                    {skill.name}
                  </li>
                ))}
              </ul>
              <span class="corner" aria-hidden="true" />
            </section>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .skills {
    background: var(--c-primary-soft);
    border-block: var(--border);
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(9.5rem, auto);
    grid-auto-flow: row dense;
    gap: 1.25rem;
  }
  .size-tall {
    grid-row: span 2;
  }
  .size-wide {
    grid-column: span 2;
  }
  .size-big {
    grid-column: span 2;
    grid-row: span 2;
  }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem;
    overflow: hidden;
    background: var(--c-surface);
    color: var(--c-ink);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }
  .tile:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--c-shadow);
  }
  .tile-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .tile-mark {
    width: 0.75rem;
    height: 0.75rem;
    flex: none;
    background: var(--c-primary);
    transform: rotate(45deg);
  }
  h3 {
    font-size: 1.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.7rem 0.35rem 0.5rem;
    border: 2px solid currentColor;
    font-weight: 500;
    font-size: 0.9375rem;
    transition:
      transform 160ms var(--ease-out),
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out);
  }
  li:hover {
    transform: translateY(-2px);
    background: var(--c-primary);
    color: var(--c-on-primary);
    border-color: var(--c-ink);
  }
  .slot {
    width: 0.55rem;
    height: 0.55rem;
    flex: none;
    background: var(--c-primary);
  }
  li:hover .slot {
    background: var(--c-on-primary);
  }
  /* Pixel staircase in the bottom-right corner of every tile. */
  .corner {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 2.25rem;
    height: 2.25rem;
    background:
      linear-gradient(var(--c-primary), var(--c-primary)) right bottom / 0.75rem 2.25rem no-repeat,
      linear-gradient(var(--c-primary), var(--c-primary)) right bottom / 1.5rem 1.5rem no-repeat,
      linear-gradient(var(--c-primary), var(--c-primary)) right bottom / 2.25rem 0.75rem no-repeat;
    opacity: 0.35;
    pointer-events: none;
  }

  /* Tall accent tile: the core stack, in brand orange with black text. */
  .tone-accent {
    background: var(--c-primary);
    color: var(--c-on-primary);
    justify-content: space-between;
  }
  .tone-accent .tile-head {
    align-items: flex-start;
  }
  .tone-accent .tile-mark {
    margin-top: 0.85rem;
  }
  .tone-accent h3 {
    font-size: clamp(2.25rem, 4vw, 3rem);
  }
  .tone-accent .tile-mark,
  .tone-accent .slot {
    background: var(--c-on-primary);
  }
  .tone-accent li {
    border-color: var(--c-on-primary);
    background: var(--c-surface);
    color: var(--c-ink);
  }
  .tone-accent .corner {
    --c-primary: #0a0a0a;
    opacity: 0.25;
  }

  /* Big dark tile: the widest toolbox, like a terminal screen. */
  .tone-dark {
    background: #0a0a0a;
    color: #fafafa;
    background-image:
      linear-gradient(rgb(255 107 53 / 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 107 53 / 0.1) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .tone-dark h3 {
    color: var(--c-primary);
    font-size: clamp(2rem, 3.5vw, 2.5rem);
  }
  .tone-dark li {
    border-color: #d4d4d8;
    color: #fafafa;
    background: #111111;
  }
  .tone-dark li:hover {
    background: var(--c-primary);
    color: #0a0a0a;
    border-color: var(--c-primary);
  }
  :global([data-theme="dark"]) .tone-dark {
    border-color: var(--c-primary);
  }

  @media (max-width: 960px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .size-tall {
      grid-row: span 1;
    }
  }
  @media (max-width: 560px) {
    .bento {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
    .size-wide,
    .size-big {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
