---
import type { Locale, PublishedContent } from "../content";
import type { UiStrings } from "../i18n/ui";
import PixelIcon, { type IconName } from "./PixelIcon.astro";

interface Props {
  contact: PublishedContent["contact"];
  locale: Locale;
  t: UiStrings;
  mailto: string;
  whatsappHref: string;
}

const { contact, locale, t, mailto, whatsappHref } = Astro.props;
const f = t.contact.form;

// "+50670429481" → "+506 7042-9481"; other numbers are shown as stored.
const cr = /^\+506(\d{4})(\d{4})$/.exec(contact.whatsapp);
const phone = cr ? `+506 ${cr[1]}-${cr[2]}` : contact.whatsapp;

// EmailJS ids are public by design (they are sent from the browser).
const emailjs = {
  service: import.meta.env.PUBLIC_EMAILJS_SERVICE_ID ?? "",
  template: import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID ?? "",
  key: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? "",
};

const channels: {
  icon: IconName;
  label: string;
  value: string;
  href: string;
  external: boolean;
}[] = [
  {
    icon: "mail",
    label: t.contact.email,
    value: contact.email,
    href: mailto,
    external: false,
  },
  {
    icon: "whatsapp",
    label: t.contact.whatsapp,
    value: phone,
    href: whatsappHref,
    external: true,
  },
  ...(contact.linkedinUrl
    ? [
        {
          icon: "linkedin" as const,
          label: t.contact.linkedin,
          value: contact.linkedinUrl
            .replace(/^https:\/\/(www\.)?/, "")
            .replace(/\/$/, ""),
          href: contact.linkedinUrl,
          external: true,
        },
      ]
    : []),
  ...(contact.githubUrl
    ? [
        {
          icon: "github" as const,
          label: t.contact.github,
          value: contact.githubUrl.replace(/^https:\/\//, ""),
          href: contact.githubUrl,
          external: true,
        },
      ]
    : []),
];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-head reveal">
      <h2 id="contact-title" class="section-title">{t.contact.title}</h2>
      <p class="section-intro">{t.contact.intro}</p>
    </div>

    <div class="contact-grid">
      <ul class="channels">
        {
          channels.map((c, i) => (
            <li class="reveal" style={`--delay: ${i * 70}ms`}>
              <a
                class="channel"
                href={c.href}
                {...(c.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <span class="channel-icon"><PixelIcon name={c.icon} /></span>
                <span class="channel-text">
                  <span class="channel-label">{c.label}</span>
                  <span class="channel-value">{c.value}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="window form-window reveal" style="--delay: 120ms">
        <div class="window-bar">
          <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <span>{f.title}</span>
        </div>
        <form
          class="form"
          novalidate
          data-contact-form
          data-service={emailjs.service}
          data-template={emailjs.template}
          data-key={emailjs.key}
          data-msg-required={f.required}
          data-msg-email={f.invalidEmail}
          data-msg-invalid={f.invalid}
          data-msg-sending={f.sending}
          data-msg-sent={f.sent}
          data-msg-error={f.error}
          data-msg-unavailable={f.unavailable}
        >
          <input type="hidden" name="locale" value={locale} />
          <div class="field">
            <label for="cf-name">{f.name}</label>
            <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="80" aria-describedby="cf-name-error" />
            <p class="error" id="cf-name-error" data-error-for="name"></p>
          </div>
          <div class="field">
            <label for="cf-email">{f.email}</label>
            <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="120" aria-describedby="cf-email-error" />
            <p class="error" id="cf-email-error" data-error-for="email"></p>
          </div>
          <div class="field">
            <label for="cf-company">{f.company}</label>
            <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="80" />
          </div>
          <div class="field">
            <label for="cf-message">{f.message}</label>
            <textarea id="cf-message" name="message" rows="5" required maxlength="2000" aria-describedby="cf-message-error"></textarea>
            <p class="error" id="cf-message-error" data-error-for="message"></p>
          </div>
          <!-- Honeypot: people never see it; bots fill it and get ignored. -->
          <div class="hp" aria-hidden="true">
            <label for="cf-website">Website</label>
            <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn btn-primary submit" type="submit">{f.send}</button>
          <p class="status" role="status" aria-live="polite" data-status></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  .channels {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .channel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1rem;
    color: var(--c-ink);
    text-decoration: none;
    background: var(--c-surface);
    border: var(--border);
    box-shadow: var(--shadow-sm);
    transition:
      transform 160ms var(--ease-out),
      box-shadow 160ms var(--ease-out);
  }
  .channel:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--c-shadow);
  }
  .channel-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    font-size: 1.35rem;
    background: var(--c-primary);
    color: var(--c-on-primary);
    border: 2px solid var(--c-ink);
  }
  .channel-text {
    display: grid;
    min-width: 0;
  }
  .channel-label {
    font: 600 1.25rem/1.1 var(--font-display);
  }
  .channel-value {
    overflow-wrap: anywhere;
    color: var(--c-ink-soft);
  }
  .form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .field {
    display: grid;
    gap: 0.35rem;
  }
  label {
    font-weight: 700;
  }
  input,
  textarea {
    width: 100%;
    min-height: 2.875rem;
    padding: 0.6rem 0.75rem;
    font: inherit;
    color: var(--c-ink);
    background: var(--c-canvas);
    border: 2px solid var(--c-ink);
    border-radius: 0;
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--c-focus);
    outline-offset: 0;
  }
  [aria-invalid="true"] {
    border-color: var(--c-primary-dark);
    box-shadow: 4px 4px 0 var(--c-primary);
  }
  .error {
    min-height: 0;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--c-primary-dark);
  }
  :global([data-theme="dark"]) .error {
    color: var(--c-accent);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .submit {
    justify-self: start;
  }
  .submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .status {
    font-weight: 700;
  }
  .status:empty {
    display: none;
  }
  .status[data-kind="ok"] {
    padding: 0.75rem 1rem;
    background: var(--c-primary);
    color: var(--c-on-primary);
    border: 2px solid var(--c-ink);
  }
  .status[data-kind="error"] {
    padding: 0.75rem 1rem;
    border: 2px solid var(--c-primary-dark);
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { sendForm } from "@emailjs/browser";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const d = form.dataset;
    const status = form.querySelector<HTMLElement>("[data-status]");
    const submit = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const setStatus = (text: string, kind: "ok" | "error" | "info") => {
      if (!status) return;
      status.textContent = text;
      status.dataset.kind = kind;
    };
    const fieldError = (name: string, message: string) => {
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      input?.setAttribute("aria-invalid", message ? "true" : "false");
      if (error) error.textContent = message;
      return !message;
    };
    const validate = () => {
      const value = (name: string) =>
        ((form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? "").trim();
      const email = value("email");
      const results = [
        fieldError("name", value("name") ? "" : (d.msgRequired ?? "")),
        fieldError(
          "email",
          !email
            ? (d.msgRequired ?? "")
            : /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
              ? ""
              : (d.msgEmail ?? ""),
        ),
        fieldError("message", value("message") ? "" : (d.msgRequired ?? "")),
      ];
      return results.every(Boolean);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!validate()) {
        setStatus(d.msgInvalid ?? "", "error");
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      // Honeypot filled: act as sent without sending anything.
      const honeypot = form.elements.namedItem("website") as HTMLInputElement | null;
      if (honeypot?.value) {
        form.reset();
        setStatus(d.msgSent ?? "", "ok");
        return;
      }
      if (!d.service || !d.template || !d.key) {
        setStatus(d.msgUnavailable ?? "", "error");
        return;
      }
      if (submit) submit.disabled = true;
      setStatus(d.msgSending ?? "", "info");
      try {
        await sendForm(d.service, d.template, form, {
          publicKey: d.key,
          // One message per minute from the same browser.
          limitRate: { id: "contact-form", throttle: 60_000 },
        });
        form.reset();
        setStatus(d.msgSent ?? "", "ok");
      } catch {
        setStatus(d.msgError ?? "", "error");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>
