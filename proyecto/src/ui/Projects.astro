---
import type { PublishedContent } from "../content";
import type { UiStrings } from "../i18n/ui";
import PixelIcon from "./PixelIcon.astro";

interface Props {
  projects: PublishedContent["projects"];
  t: UiStrings;
}

const { projects, t } = Astro.props;

// Filters: every technology used by a project, most used first.
const counts = new Map<string, number>();
for (const p of projects) {
  for (const tech of p.technologies)
    counts.set(tech, (counts.get(tech) ?? 0) + 1);
}
const filters = [...counts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tech]) => tech);

/**
 * Pixel "code window" cover drawn from the title, so projects without an
 * image still get their own SVG illustration. Deterministic per title.
 */
function cover(title: string) {
  let seed = 0;
  for (const ch of title) seed = (seed * 31 + ch.charCodeAt(0)) >>> 0;
  const next = () => {
    seed = (seed * 1103515245 + 12345) >>> 0;
    return seed / 2 ** 32;
  };
  const lines: { x: number; y: number; w: number; accent: boolean }[] = [];
  for (let row = 0; row < 7; row++) {
    const indent = Math.floor(next() * 3) * 2;
    const width = 4 + Math.floor(next() * 16);
    lines.push({
      x: 3 + indent,
      y: 4 + row * 2,
      w: width,
      accent: next() > 0.72,
    });
  }
  return lines;
}
---

{
  projects.length > 0 && (
    <section id="projects" class="section projects-band" aria-labelledby="projects-title">
      <div class="container">
        <div class="section-head reveal">
          <h2 id="projects-title" class="section-title">
            {t.projects.title}
          </h2>
          <p class="section-intro">{t.projects.intro}</p>
        </div>

        <div class="filters reveal" role="group" aria-label={t.projects.filterLabel} data-filters>
          <button type="button" class="filter" aria-pressed="true" data-filter="*">
            {t.projects.all}
          </button>
          {filters.map((tech) => (
            <button type="button" class="filter" aria-pressed="false" data-filter={tech}>
              {tech}
            </button>
          ))}
        </div>

        <ul class="gallery" data-gallery>
          {projects.map((p, i) => {
            const featured = i === 0;
            return (
              <li
                class:list={["project", "reveal", { featured }]}
                style={`--delay: ${(i % 3) * 90}ms`}
                data-techs={JSON.stringify(p.technologies)}
              >
                <article class="window project-card">
                  <div class="cover" aria-hidden="true">
                    <svg viewBox="0 0 28 18" shape-rendering="crispEdges" preserveAspectRatio="xMidYMid meet">
                      <rect width="28" height="18" class="cover-bg" />
                      <rect x="0" y="0" width="28" height="2" class="cover-bar" />
                      <rect x="1" y="0.5" width="1" height="1" class="cover-dot" />
                      <rect x="2.5" y="0.5" width="1" height="1" class="cover-dot" />
                      <rect x="4" y="0.5" width="1" height="1" class="cover-dot" />
                      {cover(p.title).map((l) => (
                        <rect x={l.x} y={l.y} width={l.w} height="1" class={l.accent ? "cover-accent" : "cover-line"} />
                      ))}
                      <rect x="3" y="16" width="2" height="1" class="cover-cursor" />
                    </svg>
                  </div>
                  <div class="project-body">
                    {featured && <p class="featured-label">{t.projects.featured}</p>}
                    <h3>{p.title}</h3>
                    {featured && <p class="description">{p.description}</p>}
                    <ul class="chip-list">
                      {p.technologies.map((tech) => (
                        <li class="chip">{tech}</li>
                      ))}
                    </ul>
                    <div class="card-actions">
                      {featured && p.codeUrl && (
                        <a class="btn btn-primary" href={p.codeUrl} target="_blank" rel="noopener noreferrer">
                          <PixelIcon name="code" />
                          {t.projects.code}
                        </a>
                      )}
                      {featured && p.demoUrl && (
                        <a class="btn btn-secondary" href={p.demoUrl} target="_blank" rel="noopener noreferrer">
                          <PixelIcon name="external" />
                          {t.projects.demo}
                        </a>
                      )}
                      <button type="button" class="btn btn-secondary" data-open={`project-${i}`}>
                        {t.projects.details}
                      </button>
                    </div>
                  </div>
                </article>

                <dialog class="window modal" id={`project-${i}`} aria-labelledby={`project-${i}-title`}>
                  <div class="window-bar">
                    <div class="window-dots" aria-hidden="true">
                      <span />
                      <span />
                      <span />
                    </div>
                    <form method="dialog">
                      <button class="close" aria-label={t.projects.close}>
                        <PixelIcon name="close" />
                      </button>
                    </form>
                  </div>
                  <div class="modal-body">
                    <h3 id={`project-${i}-title`}>{p.title}</h3>
                    <p>{p.description}</p>
                    <ul class="chip-list">
                      {p.technologies.map((tech) => (
                        <li class="chip">{tech}</li>
                      ))}
                    </ul>
                    {(p.codeUrl || p.demoUrl) && (
                      <div class="links">
                        {p.codeUrl && (
                          <a class="btn btn-primary" href={p.codeUrl} target="_blank" rel="noopener noreferrer">
                            <PixelIcon name="code" />
                            {t.projects.code}
                          </a>
                        )}
                        {p.demoUrl && (
                          <a class="btn btn-secondary" href={p.demoUrl} target="_blank" rel="noopener noreferrer">
                            <PixelIcon name="external" />
                            {t.projects.demo}
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </dialog>
              </li>
            );
          })}
        </ul>
        <p class="empty" hidden data-empty>
          {t.projects.empty}
        </p>
      </div>
    </section>
  )
}

<style>
  /* Dark band in both themes so the projects are the focal point. The dark
     brand tokens are redefined locally; the dialog inherits them too. */
  .projects-band {
    --c-ink: #d4d4d8;
    --c-ink-soft: #a1a1aa;
    --c-accent: #ff9a5c;
    --c-link: #ff9a5c;
    --c-primary-soft: #2a1308;
    --c-canvas: #0a0a0a;
    --c-surface: #111111;
    --c-shadow: #c2410c;
    --c-focus: #ff9a5c;
    --border: 3px solid var(--c-ink);
    --shadow: 6px 6px 0 var(--c-shadow);
    --shadow-sm: 4px 4px 0 var(--c-shadow);
    position: relative;
    color: var(--c-ink);
    background-color: #0a0a0a;
    background-image:
      linear-gradient(rgb(255 107 53 / 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 107 53 / 0.08) 1px, transparent 1px);
    background-size: 32px 32px;
    border-block: 6px solid var(--c-primary);
  }
  :global([data-theme="dark"]) .projects-band {
    background-color: #2a1308;
  }
  .projects-band .section-title {
    color: var(--c-primary);
    font-size: clamp(3rem, 8vw, 5rem);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .filter {
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    font: 500 0.9375rem / 1 var(--font-body);
    color: var(--c-ink);
    background: var(--c-surface);
    border: 2px solid var(--c-ink);
    cursor: pointer;
    transition: background-color 200ms var(--ease-out);
  }
  .filter:hover {
    background: var(--c-primary-soft);
  }
  .filter[aria-pressed="true"] {
    background: var(--c-primary);
    color: var(--c-on-primary);
    border-color: var(--c-primary);
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .project[hidden] {
    display: none;
  }
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }
  .project-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 10px 10px 0 var(--c-shadow);
  }
  .cover {
    display: grid;
    place-items: center;
    padding: 1rem;
    background: #0a0a0a;
    border-bottom: var(--border);
    aspect-ratio: 28 / 15;
    overflow: hidden;
  }
  .cover svg {
    width: 100%;
    height: 100%;
  }
  .cover-bg {
    fill: #0a0a0a;
  }
  .cover-bar,
  .cover-line {
    fill: var(--c-primary);
  }
  .cover-dot {
    fill: #0a0a0a;
  }
  .cover-accent {
    fill: #ff9a5c;
  }
  .cover-cursor {
    fill: var(--c-primary);
    animation: blink 1s steps(1, end) infinite;
  }
  .project-body {
    display: grid;
    gap: 1rem;
    align-content: start;
    flex: 1;
    padding: 1.25rem 1.25rem 1.5rem;
  }
  .project-body h3 {
    font-size: 2rem;
  }
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
  }

  /* Featured project: full width, cover beside the details. */
  .featured {
    grid-column: 1 / -1;
  }
  .featured .project-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    box-shadow: 10px 10px 0 var(--c-shadow);
  }
  .featured .project-card:hover {
    transform: translate(-4px, -4px);
    box-shadow: 14px 14px 0 var(--c-shadow);
  }
  .featured .cover {
    aspect-ratio: auto;
    min-height: 100%;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-bottom: 0;
    border-right: var(--border);
  }
  .featured .cover svg {
    height: auto;
    border: 3px solid var(--c-primary);
    box-shadow: 8px 8px 0 var(--c-shadow);
  }
  .featured .project-body {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    gap: 1.25rem;
  }
  .featured-label {
    justify-self: start;
    padding: 0.3rem 0.7rem 0.2rem;
    background: var(--c-primary);
    color: var(--c-on-primary);
    font: 600 1.125rem / 1 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .featured h3 {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
  }
  .description {
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 52ch;
  }
  .empty {
    margin-top: 1rem;
    color: var(--c-ink-soft);
  }

  .modal {
    width: min(100% - 2rem, 40rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    color: var(--c-ink);
  }
  .modal::backdrop {
    background: rgb(10 10 10 / 0.75);
  }
  .modal[open] {
    animation: pop 260ms var(--ease-out);
  }
  @keyframes pop {
    from {
      transform: scale(0.96);
      opacity: 0;
    }
  }
  .close {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin: -0.25rem -0.4rem;
    font-size: 1rem;
    color: var(--c-on-primary);
    background: transparent;
    border: 2px solid var(--c-on-primary);
    cursor: pointer;
  }
  .modal-body {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }
  .modal-body h3 {
    font-size: clamp(2rem, 5vw, 2.75rem);
  }
  .modal-body p {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 760px) {
    .featured .project-card {
      grid-template-columns: 1fr;
    }
    .featured .cover {
      aspect-ratio: auto;
      min-height: 0;
      border-right: 0;
      border-bottom: var(--border);
    }
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-open]")) {
    button.addEventListener("click", () => {
      const dialog = document.getElementById(button.dataset.open ?? "");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  }
  // Clicking the backdrop closes the dialog.
  for (const dialog of document.querySelectorAll<HTMLDialogElement>("dialog.modal")) {
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  const group = document.querySelector("[data-filters]");
  const items = [...document.querySelectorAll<HTMLElement>("[data-gallery] > li")];
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  group?.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
    if (!target) return;
    for (const b of group.querySelectorAll("[data-filter]")) {
      b.setAttribute("aria-pressed", String(b === target));
    }
    const tech = target.dataset.filter;
    let shown = 0;
    for (const item of items) {
      const techs: string[] = JSON.parse(item.dataset.techs ?? "[]");
      const visible = tech === "*" || techs.includes(tech ?? "");
      item.hidden = !visible;
      if (visible) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  });
</script>
