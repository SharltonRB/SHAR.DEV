---
import "@fontsource/handjet/600.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/700.css";
import "./styles/global.css";
import type { Locale } from "../content";
import { homePath } from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Pages that exist in both languages get hreflang alternates. */
  alternates?: boolean;
}

const { locale, title, description, alternates = false } = Astro.props;
const site = Astro.site ?? new URL("https://shardev-portfolio.vercel.app");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/icon-512.png", site).href;
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(homePath.en, site).href} />
          <link rel="alternate" hreflang="es" href={new URL(homePath.es, site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(homePath.en, site).href} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FF6B35" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SHAR.DEV" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "es_CR"} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Runs before paint: saved theme, else the system preference (no flash).
      (() => {
        const root = document.documentElement;
        root.classList.remove("no-js");
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        root.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
