{
  "name": "shar-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "astro check",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.ts",
    "content:import": "tsx --env-file-if-exists=.env.local scripts/content-import.ts"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.17",
    "@emailjs/browser": "5.0.3",
    "@fontsource/handjet": "5.3.1",
    "@fontsource/space-grotesk": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "astro": "7.4.4",
    "drizzle-orm": "0.45.4",
    "lottie-web": "5.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "@electric-sql/pglite": "0.5.13",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
